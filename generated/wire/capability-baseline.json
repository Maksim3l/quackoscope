      "kinds": [
        "action",
        "action"
      ]
    },
    {
      "id": "configuration.save",
      "wire_methods": [
        "save_instance_configuration_to_string"
      ],
      "kinds": [
        "getter"
      ]
    },
    {
      "id": "configuration.load",
      "wire_methods": [
        "load_instance_configuration_from_string"
      ],
      "kinds": [
        "action"
      ]
