{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "quackoscope",
  "version": "0.1.0",
  "identifier": "com.lokna.quackoscope",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm serve-spa-from-host",
      "wait": false
    },
    "devUrl": "http://127.0.0.1:7788",
    "beforeBuildCommand": "node tools/windows-installer/stage-host-and-opendaq-runtime-into-the-installer-payload.mjs",
    "frontendDist": "http://127.0.0.1:7788"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "bundled-host-and-opendaq-runtime": "host-and-opendaq-runtime"
    }
  }
}
