{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "quackoscope",
  "version": "0.1.0",
  "identifier": "com.lokna.quackoscope",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm serve-spa-from-host",
      "wait": false
    },
    "devUrl": "http://127.0.0.1:7788",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "http://127.0.0.1:7788"
  },
  "app": {
    "windows": [
      {
        "title": "quackoscope",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
